# Database Configuration Template
# Copy this file to 'db.properties' and fill in your actual credentials.
# 'db.properties' is automatically ignored by Git to protect sensitive information.

# MySQL Example (Default for local MySQL80 service):
db.url=jdbc:mysql://localhost:3306/expense_tracker_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
db.user=root
db.password=your_mysql_password

# PostgreSQL Example:
# db.url=jdbc:postgresql://localhost:5432/expense_tracker_db
# db.user=postgres
# db.password=your_postgres_password
